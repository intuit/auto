{
  "name": "@auto-it/maven",
  "version": "11.3.6",
  "main": "dist/index.js",
  "description": "Maven publishing plugin for auto",
  "license": "MIT",
  "author": {
    "name": "Andrew Lisowski",
    "email": "lisowski54@gmail.com"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/intuit/auto"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "automation",
    "semantic",
    "release",
    "github",
    "labels",
    "automated",
    "continuos integration",
    "changelog",
    "released",
    "comment"
  ],
  "scripts": {
    "build": "tsdown",
    "start": "tsdown -w",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.mts --maxWorkers=2"
  },
  "dependencies": {
    "@auto-it/core": "workspace:*",
    "fast-glob": "^3.3.3",
    "fp-ts": "^2.16.11",
    "io-ts": "^2.2.22",
    "jsdom": "^30.1.3",
    "parse-github-url": "^1.0.4",
    "pom-parser": "^1.1.1",
    "prettier": "^3.9.10",
    "semver": "^7.8.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/semver": "^7.8.0",
    "tsdown": "catalog:"
  }
}
