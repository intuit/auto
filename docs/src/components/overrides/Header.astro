---
/**
 * Site header: logo, primary links, search, a GitHub button and the theme
 * toggle. Replaces Starlight's default (logo · search · social icons · theme).
 */
import Search from "@astrojs/starlight/components/Search.astro";
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import LanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro";

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

const links = [
  { label: "Docs", href: `${base}/docs`, match: `${base}/docs` },
  { label: "Blog", href: `${base}/blog`, match: `${base}/blog` },
  {
    label: "Plugins",
    href: `${base}/docs/configuration/plugins`,
    match: `${base}/docs/configuration/plugins`,
  },
];

/** The most specific link whose path prefixes the current one */
const current = links
  .filter((link) => path === link.match || path.startsWith(`${link.match}/`))
  .sort((a, b) => b.match.length - a.match.length)[0];
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>

  <nav class="sl-hidden md:sl-flex links print:hidden" aria-label="Primary">
    {
      links.map((link) => (
        <a href={link.href} aria-current={link === current ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="sl-flex search print:hidden">
    <Search />
  </div>

  <div class="sl-hidden md:sl-flex right-group print:hidden">
    <a class="icon-btn" href="https://github.com/intuit/auto" aria-label="GitHub" title="GitHub">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
    </a>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  .header {
    display: flex;
    align-items: center;
    gap: var(--sl-nav-gap);
    height: 100%;
  }

  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }

  /* Starlight sizes the logo by height; the wordmark wants to be a bit taller */
  .title-wrapper :global(img) {
    height: 1.875rem;
  }

  .links {
    gap: 1.75rem;
    margin-inline-start: 0.75rem;
  }

  .links a {
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
  }

  .links a:hover,
  .links a[aria-current="page"] {
    color: var(--sl-color-text-accent);
  }

  .search {
    flex: 1;
    justify-content: flex-end;
  }

  .right-group {
    gap: 0.75rem;
    align-items: center;
  }

  /* Round, icon-only controls: GitHub link and the theme select */
  .icon-btn,
  .right-group :global(starlight-theme-select label) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }

  .icon-btn:hover,
  .right-group :global(starlight-theme-select label:hover) {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  /* The select stays (keyboard/screen-reader friendly) but is invisible over
     the icon; its text and caret are hidden */
  .right-group :global(starlight-theme-select label) {
    --sl-label-icon-size: 1.25rem;
    gap: 0;
  }

  .right-group :global(starlight-theme-select .label-icon) {
    position: static;
    transform: none;
  }

  .right-group :global(starlight-theme-select .caret) {
    display: none;
  }

  .right-group :global(starlight-theme-select select) {
    position: absolute;
    inset: 0;
    width: 100%;
    margin: 0;
    padding: 0;
    color: transparent;
    opacity: 0;
  }

  @media (min-width: 50rem) {
    .search {
      max-width: 22rem;
      margin-inline-start: auto;
    }
  }
</style>
