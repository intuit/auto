{
  "name": "auto-monorepo",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Andrew Lisowski",
    "email": "lisowski54@gmail.com"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/intuit/auto"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "clean": "rimraf node_modules '+(packages|plugins)/*/node_modules' '+(packages|plugins)/**/+(dist|tsconfig.tsbuildinfo)'",
    "build": "pnpm -r run build",
    "start": "pnpm -r --parallel run start",
    "lint": "oxlint packages plugins",
    "type-check": "pnpm -r --no-bail --no-sort run type-check",
    "test": "vitest run --no-file-parallelism",
    "test:coverage": "npm run test -- --coverage",
    "auto": "chmod +x ./packages/cli/dist/bin/auto.mjs && ./packages/cli/dist/bin/auto.mjs",
    "contributors:add": "all-contributors",
    "contributors:generate": "all-contributors generate",
    "docs": "pnpm docs:generate && NODE_OPTIONS=--openssl-legacy-provider ignite dev",
    "docs:generate": "./docs/generate-command-docs.js",
    "docs:build": "pnpm docs:generate && NODE_OPTIONS=--openssl-legacy-provider ignite build",
    "create:plugin": "./scripts/create-plugin.js",
    "create:package": "./scripts/create-package.js",
    "install-mac": "pnpm --filter auto bundle && gunzip -c ./packages/cli/binary/auto-macos.gz > /usr/local/bin/auto",
    "format:diff": "prettier --cache --list-different '**/*.{js,md,mdx,ts,tsx,yml,mts}'"
  },
  "devDependencies": {
    "@atomictech/rehype-toc": "3.1.2",
    "@auto-it/all-contributors": "workspace:*",
    "@auto-it/brew": "workspace:*",
    "@auto-it/first-time-contributor": "workspace:*",
    "@auto-it/npm": "workspace:*",
    "@auto-it/pr-body-labels": "workspace:*",
    "@auto-it/protected-branch": "workspace:*",
    "@auto-it/released": "workspace:*",
    "@auto-it/upload-assets": "workspace:*",
    "@fortawesome/fontawesome-svg-core": "^1.2.27",
    "@fortawesome/free-solid-svg-icons": "^5.12.1",
    "@fortawesome/react-fontawesome": "^0.1.9",
    "@types/mock-fs": "^4.13.0",
    "@types/node": "catalog:",
    "@types/parse-github-url": "1.0.0",
    "@types/tapable": "2.2.2",
    "@vitest/coverage-v8": "^5.0.5",
    "all-contributors-cli": "^6.4.0",
    "change-case": "^4.0.0",
    "command-line-docs": "^0.0.6",
    "copy-template-dir": "^1.4.0",
    "endent": "^2.1.0",
    "fast-glob": "^3.1.1",
    "graphql": "^15.0.0",
    "husky": "^5.2.0",
    "jest-serializer-path": "^0.1.15",
    "jest-snapshot-serializer-ansi": "^1.0.0",
    "lerna": "^7.1.4",
    "lint-staged": "^17.6.0",
    "mock-fs": "^5.5.0",
    "next-ignite": "^0.10.11",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "push-dir": "^0.4.1",
    "requireg": "^0.2.2",
    "rimraf": "^3.0.0",
    "semver": "^7.0.0",
    "signale": "^1.4.0",
    "simple-react-lightbox": "^3.1.2-3",
    "title-case": "^3.0.2",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "webpack": "^4.46.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,json,css,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "prettier --parser typescript --write",
      "oxlint --fix"
    ]
  }
}
